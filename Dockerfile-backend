FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src
COPY csharp/ ./APS/
RUN dotnet restore APS/APS.csproj
RUN dotnet publish APS/APS.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app .
EXPOSE 5000
ENV ASPNETCORE_URLS=http://+:5000
ENTRYPOINT ["dotnet", "APS.dll"]