{
  "ConnectionStrings": {
    "DefaultDb": "Server=localhost;Port=3306;Database=aps_db;Uid=aps_user;Pwd=aps_pass;",
    "PostgresDb": "Host=localhost;Port=5432;Database=aps_db;Username=aps_user;Password=aps_pass;"
  },
  "Scheduler": {
    "DefaultAlgorithm": "GA",
    "ScanIntervalMinutes": 5,
    "PlanningHorizonDays": 14,
