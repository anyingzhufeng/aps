  "GA": {
    "PopulationSize": 100,
    "MaxGenerations": 200,
    "CrossoverRate": 0.8,
    "MutationRate": 0.1,
    "EliteCount": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "APS.Worker": "Debug"
    }
  },
  "AllowedHosts": "*"
}